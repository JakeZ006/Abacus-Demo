{
  "name": "template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:* ",
    "dev:vite": "vite",
    "dev:sass": "sass  --no-source-map src/scss:src/",
    "dev:sassCompile": "sass  --no-source-map --watch src/scss:src/ ",
    "postbuild": "postcss src/*.css -u autoprefixer -r --no-map",
    "watch:sass": "sass  --no-source-map --watch src/scss:public/css",
    "build": "vite build",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.4.2",
    "gh-pages": "^6.3.0",
    "node-gyp": "^13.0.1",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "postcss-cli": "^9.1.0",
    "prettier": "3.9.6",
    "sass": "^1.104.1",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
